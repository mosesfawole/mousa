# Keep credentials in .env.local or private deployment settings. Never use NEXT_PUBLIC_.
# Configure any subset. No host keys means the labelled sample experience.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
# Host routing accepts only openrouter/free or a model ending in :free.
OPENROUTER_MODEL=openrouter/free
FORTYTWO_API_KEY=
FORTYTWO_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# priority: prefer free providers, then credits; rotate: randomize the first provider.
# Only configured providers in this list participate. Omit paid providers to exclude them.
MOUSA_AI_PROVIDER_ORDER=groq,openrouter,fortytwo,anthropic,openai
MOUSA_AI_ROUTING=priority

# Required for shared AI in production. Personal keys and sample mode work without Redis.
# Upstash stores expiring counters, not drafts or provider API keys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
MOUSA_AI_VISITOR_DAILY_LIMIT=10
MOUSA_AI_GLOBAL_DAILY_LIMIT=100
